# Copy to .env and adjust. Every setting the app reads is listed here;
# docs/README "Environment variables" explains each one.

# --- Runtime -----------------------------------------------------------------
# development | test | production. Production turns on Secure cookies.
APP_ENV=development

# --- Database ----------------------------------------------------------------
# psycopg 3 driver. Inside docker compose the host is "db"; locally, "localhost".
DATABASE_URL=postgresql+psycopg://navbat:navbat@localhost:5433/navbat
# Separate database used by pytest. Tests never touch DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://navbat:navbat@localhost:5433/navbat_test

# --- Auth --------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720
# Login rate limit: at most N failed attempts per (IP, email) per window.
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# --- Email (the 6-digit sign-in codes) ---------------------------------------
# Leave SMTP_HOST empty to log the message to the console instead of sending it
# (development and tests). Production refuses to start without it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Navbat <no-reply@navbat.local>
# starttls (port 587) | ssl (port 465) | none (a local test server only)
SMTP_SECURITY=starttls

# --- First barber (used by scripts/create_barber.py and the seed script) ------
# The first demo barber's email. There are no passwords: every barber signs in
# with a code emailed to their address.
BARBER_EMAIL=jasur@navbat.local

# --- Demo data ---------------------------------------------------------------
# true: the Docker entrypoint runs `python -m scripts.seed` after migrating
# (barbershop, services, barbers, hours, a demo customer, sample bookings).
SEED_DEMO_DATA=false
